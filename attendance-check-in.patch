+<!DOCTYPE html>
+<html lang="vi" xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Lịch sử chấm công — CoffeeHRM</title>
+    <link rel="preconnect" href="https://fonts.googleapis.com">
+    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
+    <link rel="stylesheet" th:href="@{/css/AttendanceHistory.css}">
+</head>
+<body>
+<header th:replace="~{fragments/navbar :: admin('attendance')}"></header>
+
+<main class="wrap dash-main">
+    <section class="welcome">
+        <div class="eyebrow">Hệ thống — Admin</div>
+        <h1>Lịch sử chấm công</h1>
+        <p>Toàn bộ Manager và Staff. Admin không chấm công hộ cửa hàng.</p>
+    </section>
+
+    <p class="flash" th:if="${pageError}" th:text="${pageError}">Lỗi</p>
+
+    <section class="summary">
+        <article>
+            <div class="label">Số bản ghi</div>
+            <div class="value" th:text="${history.recordCount}">0</div>
+        </article>
+        <article>
+            <div class="label">Tổng thời gian làm việc</div>
+            <div class="value" th:text="${history.totalHoursLabel}">0 giờ</div>
+        </article>
+    </section>
+
+    <section class="panel">
+        <h2>Bộ lọc</h2>
+        <p class="note">Tổng thời gian chỉ tính các ca đã check-out. Ca và giờ trên từng dòng là dữ liệu lưu lúc chấm công.</p>
+        <form class="filter-form" method="get" th:action="@{/attendance/admin}">
+            <label>Cửa hàng
+                <select name="storeId">
+                    <option value="">Tất cả</option>
+                    <option th:each="store : ${history.stores}"
+                            th:value="${store.storeId}"
+                            th:text="${store.storeName}"
+                            th:selected="${history.filterStoreId != null and history.filterStoreId.equals(store.storeId)}">
+                        Cửa hàng
+                    </option>
+                </select>
+            </label>
+            <label>Nhân viên
+                <select name="employeeId">
+                    <option value="">Tất cả</option>
+                    <option th:each="emp : ${history.employees}"
+                            th:value="${emp.employeeId}"
+                            th:text="${emp.fullName + ' (#' + emp.employeeId + ')'}"
+                            th:selected="${history.filterEmployeeId != null and history.filterEmployeeId.equals(emp.employeeId)}">
+                        Nhân viên
+                    </option>
+                </select>
+            </label>
+            <label>Ca
+                <select name="shiftId">
+                    <option value="">Tất cả</option>
+                    <option th:each="shift : ${history.shifts}"
+                            th:value="${shift.shiftId}"
+                            th:text="${shift.label}"
+                            th:selected="${history.filterShiftId != null and history.filterShiftId.equals(shift.shiftId)}">
+                        Ca
+                    </option>
+                </select>
+            </label>
+            <label>Trạng thái
+                <select name="status">
+                    <option value="">Tất cả</option>
+                    <option th:each="st : ${history.statuses}"
+                            th:value="${st.value}"
+                            th:text="${st.label}"
+                            th:selected="${history.filterStatus != null and history.filterStatus.equals(st.value)}">
+                        Trạng thái
+                    </option>
+                </select>
+            </label>
+            <label>Từ ngày
+                <input type="date" name="from" th:max="${vietnamToday}" th:value="${#temporals.format(history.fromDate, 'yyyy-MM-dd')}">
+            </label>
+            <label>Đến ngày
+                <input type="date" name="to" th:max="${vietnamToday}" th:value="${#temporals.format(history.toDate, 'yyyy-MM-dd')}">
+            </label>
+            <label>Đi muộn
+                <input type="checkbox" name="late" value="true" th:checked="${history.lateOnly}">
+            </label>
+            <label>Về sớm
+                <input type="checkbox" name="early" value="true" th:checked="${history.earlyOnly}">
+            </label>
+            <button class="primary-btn" type="submit">Xem lịch sử</button>
+        </form>
+    </section>
+
+    <section class="panel">
+        <h2>Chi tiết</h2>
+        <p class="empty" th:if="${#lists.isEmpty(history.rows)}">Không có dữ liệu chấm công trong khoảng thời gian này.</p>
+        <div class="table-wrap" th:if="${!#lists.isEmpty(history.rows)}">
+            <table>
+                <thead>
+                <tr>
+                    <th>Ngày</th>
+                    <th>Nhân viên</th>
+                    <th>Cửa hàng</th>
+                    <th>Ca</th>
+                    <th>Bắt đầu ca</th>
+                    <th>Kết thúc ca</th>
+                    <th>Check-in</th>
+                    <th>Check-out</th>
+                    <th>Thời gian làm</th>
+                    <th>Đi muộn</th>
+                    <th>Về sớm</th>
+                    <th>Còn thiếu</th>
+                    <th>IP Check-in</th>
+                    <th>IP Check-out</th>
+                    <th>Trạng thái</th>
+                </tr>
+                </thead>
+                <tbody>
+                <tr th:each="row : ${history.rows}">
+                    <td th:text="${#temporals.format(row.workDate, 'dd/MM/yyyy')}">01/09/2026</td>
+                    <td>
+                        <span th:text="${row.employeeName}">Tên</span>
+                        <span th:text="'#' + ${row.employeeId}">#1</span>
+                    </td>
+                    <td th:text="${row.storeName}">Cửa hàng</td>
+                    <td th:text="${row.shiftLabel}">Ca sáng</td>
+                    <td th:text="${row.scheduledStartLabel}">08:00</td>
+                    <td th:text="${row.scheduledEndLabel}">17:00</td>
+                    <td th:text="${row.checkInLabel}">08:00</td>
+                    <td th:text="${row.checkOutLabel}">17:00</td>
+                    <td th:text="${row.totalHoursLabel}">8 giờ</td>
+                    <td th:text="${row.lateLabel}">0 phút</td>
+                    <td th:text="${row.earlyLabel}">0 phút</td>
+                    <td th:text="${row.missingLabel}">0 phút</td>
+                    <td th:text="${row.checkInIp}">—</td>
+                    <td th:text="${row.checkOutIp}">—</td>
+                    <td>
+                        <span class="status-tag" th:classappend="${row.statusCss}" th:text="${row.statusLabel}">Có mặt</span>
+                    </td>
+                </tr>
+                </tbody>
+            </table>
+        </div>
+    </section>
+</main>
+</body>
+</html>
